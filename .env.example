# Quickbase realm and a user token with access to Construction Management_V2 (buskqh26r).
QB_REALM=byrdsonservices.quickbase.com
QB_USER_TOKEN=
# Google Workspace sign-in (the OAuth client shared with the Permitting Helper).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
