{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/qb.ts": {
      "maxDuration": 60
    },
    "api/up.ts": {
      "maxDuration": 60
    },
    "api/feed.ts": {
      "maxDuration": 300
    },
    "api/revise.ts": {
      "maxDuration": 120
    },
    "api/drive.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/start",
      "destination": "/api/session?action=start"
    },
    {
      "source": "/api/auth/callback",
      "destination": "/api/session?action=callback"
    },
    {
      "source": "/api/auth/signout",
      "destination": "/api/session?action=signout"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/feed",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/drive",
      "schedule": "0 11 * * *"
    }
  ]
}
